{
  "name": "dsh-feature-hub",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "An aggregator bundle for DeepSeek Harness: sidebar sections (Recent tasks) plus composer controls (a git branch chip that names and switches the branch). Written in TypeScript.",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.host.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify-client.mjs && node scripts/verify-host.mjs",
    "sync-types": "node scripts/sync-dsh-types.mjs",
    "check-types": "node scripts/sync-dsh-types.mjs --check",
    "all": "pnpm run check && pnpm run lint && pnpm run build && pnpm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "esbuild": "0.25.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
